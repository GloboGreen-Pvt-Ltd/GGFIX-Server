<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.repairshop.saas</groupId>
        <artifactId>repair-shop-services</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <artifactId>common-media</artifactId>
    <name>Common Media</name>

    <!--
        Shared S3 media storage for media.ggfix.in.

        Extracted rather than copied: master-data owns the device catalogue images
        while auth-service owns owner KYC and shop artwork, and both need the same
        slug rules, the same validation and the same bucket. Two copies of the slug
        logic would drift, and a drifted slug silently writes to a different folder —
        the sort of bug that only shows up as a missing image weeks later.

        A jar, not an application: no @SpringBootApplication, and consumers pick it
        up by adding com.repairshop.saas.common.media to their @ComponentScan.
    -->
    <packaging>jar</packaging>

    <dependencies>
        <!-- MultipartFile + the exception handler's web types. -->
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-web</artifactId></dependency>

        <!--
            S3. apache-client and netty are excluded in favour of the JDK's own HTTP
            client: it drops several MB of transitive deps off every consuming fat
            jar, which matters on the t3.micro that runs all twelve services.
        -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>s3</artifactId>
            <exclusions>
                <exclusion><groupId>software.amazon.awssdk</groupId><artifactId>apache-client</artifactId></exclusion>
                <exclusion><groupId>software.amazon.awssdk</groupId><artifactId>netty-nio-client</artifactId></exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>url-connection-client</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
                The parent turns on spring-boot-maven-plugin's repackage goal for the
                services. This module is a plain library, and repackaging it would
                produce a nested-jar layout that consumers cannot compile against.
            -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <skip>true</skip>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
