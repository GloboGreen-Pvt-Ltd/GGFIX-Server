<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.repairshop.saas</groupId>
        <artifactId>repair-shop-services</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <artifactId>common-device-specs</artifactId>
    <name>Common Device Specs</name>

    <!--
        The single definition of which device specifications belong to which
        device category (Laptop → RAM / Storage Capacity / Storage Type,
        Smartwatch → Case Size / Connectivity, Audio Device → Device Type /
        Connectivity) and how each value is normalized before it is stored
        ("16 GB" → "16GB", "NVMe SSD" → "NVME_SSD", "44 mm" → "44MM").

        Extracted rather than copied because the same booking-or-listing device
        is written by two services — ticket-service (repair bookings) and
        marketplace-service (sell listings) — and both have to accept, reject
        and normalize identically, or a laptop listed for sale would be stored
        differently from the same laptop booked for repair.

        Deliberately JDBC, not JPA, for the one master-data lookup it does
        (which optional specs a category/model explicitly supports): mapping
        master-data's tables as @Entity would drag them into the consumer's
        Hibernate validate-on-boot check. Same reasoning as common-subscription.

        A jar, not an application: no @SpringBootApplication. Consumers add
        com.repairshop.saas.common.devicespecs to their scanned packages.
    -->
    <packaging>jar</packaging>

    <dependencies>
        <!-- JdbcTemplate. The DataSource itself comes from the consuming service. -->
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-jdbc</artifactId></dependency>

        <!-- Jackson, to read master_models.ram_storage (a jsonb array). -->
        <dependency><groupId>com.fasterxml.jackson.core</groupId><artifactId>jackson-databind</artifactId></dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
                Same reason as common-media / common-subscription: the parent
                enables the repackage goal for services, and repackaging a library
                produces a nested-jar layout that consumers cannot compile against.
            -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <skip>true</skip>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
