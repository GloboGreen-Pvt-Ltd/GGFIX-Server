# Copy to .env (or set as real environment variables) and adjust. Real
# environment variables win over this file. Blank values mean "use the default".

# Where the live GGFIX catalog is read from. Defaults to the public API; a
# local master-data-service works too (http://localhost:8091).
GGFIX_API_BASE=https://api.ggfix.in

# Auth. With either set, POST /visual-search/device requires a credential:
#   JWT_SECRET - the SAME value the Spring services use; the Partner App's
#                normal `Authorization: Bearer` login token then works.
#   VS_API_KEY - optional shared secret sent as an X-API-Key header.
# Both unset = open endpoint (local development only).
JWT_SECRET=
VS_API_KEY=

# Confidence thresholds (cosine similarity, 0..1).
VS_HIGH_CONFIDENCE=0.85
VS_MEDIUM_CONFIDENCE=0.62

# Where the built index (embeddings.npy + embeddings_meta.json) lives. A
# relative path is resolved against this folder.
VS_DATA_DIR=./data

# Background indexing inside the API process (both off by default locally):
# build the index at startup when it is empty, and refresh every N hours.
VS_AUTO_INDEX=0
VS_REINDEX_INTERVAL_HOURS=0
