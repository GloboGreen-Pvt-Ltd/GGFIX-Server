# Production database is AWS RDS (managed outside this host).
DB_HOST=ggfixservice.cdaiqaog82ho.ap-south-1.rds.amazonaws.com
DB_PORT=5432
DB_NAME=ggfixservice
DB_USER=postgres
# Real value comes from the DB_PASSWORD repository secret (this file is committed
# to a public repo, so never put the live credential here).
DB_PASSWORD=change-me-to-the-rds-password

JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-characters
JWT_EXPIRY_MS=86400000

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=ggfix/master

# S3 media behind media.ggfix.in. NO access keys here: the SDK resolves credentials
# from the EC2 instance role, which must allow s3:PutObject and s3:DeleteObject on
# arn:aws:s3:::ggfix-media-1762/*. Leave AWS_S3_BUCKET blank to disable S3 uploads;
# master-data then serves everything else normally and rejects uploads with a clear
# "Image storage is not configured" rather than failing to start.
AWS_REGION=ap-south-1
AWS_S3_BUCKET=ggfix-media-1762
AWS_S3_BASE_URL=https://media.ggfix.in

# Partner app push notifications (Expo). Both optional. EXPO_ACCESS_TOKEN is
# only required when "enhanced push security" is enabled on the Expo project;
# leave it blank otherwise. PUSH_ENABLED=false stops all sends (registration
# keeps working).
EXPO_ACCESS_TOKEN=
PUSH_ENABLED=true

# FCM via the Firebase Admin SDK (Customer / Partner / Employee apps). Put the
# NAME of the AWS Secrets Manager secret that holds the service-account JSON —
# never the JSON itself, and never GOOGLE_APPLICATION_CREDENTIALS on this box.
# The EC2 instance role needs secretsmanager:GetSecretValue on that secret.
# Blank = FCM sends are skipped. FCM_ENABLED=false turns FCM off on its own.
FIREBASE_CREDENTIALS_SECRET_ID=neargfix/firebase-admin
FIREBASE_CREDENTIALS_SECRET_REGION=ap-south-1
FCM_ENABLED=true

JAVA_OPTS="-Xms64m -Xmx160m"
SERVICES="auth-service master-data-service shop-service ticket-service"

# BotBee WhatsApp booking confirmations (ticket-service). Keep ENABLED=false until
# Meta approves neargfix_booking_confirmed. Key from BotBee Developer Portal; never commit it.
BOTBEE_BASE_URL=https://nexa.botbee.io
BOTBEE_API_KEY=
BOTBEE_CHANNEL_ID=
BOTBEE_WHATSAPP_ENABLED=false
